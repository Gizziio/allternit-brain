[Unit]
Description=Allternit Brain research pipeline autonomy cycle (approvals → execute → review → land)
# VPS mirror of com.allternit.research-pipeline-cycle.plist (every 30 min,
# 07:00–22:00 local). The script self-limits outside that window via `date +%H`
# and single-instances itself with a lock on Research/.run.lock.
# SHIPPED, NOT ACTIVATED — keep autonomy.mode=shadow until the VPS leg is
# verified. Execution should stay Mac-bound unless repos + credentials move.

[Service]
Type=oneshot
# PLACEHOLDER: adjust user and paths on the VPS.
User=joe
WorkingDirectory=/opt/allternit/brain
Environment=BRAIN_ROOT=/opt/allternit/brain
ExecStart=/bin/bash /opt/allternit/brain/Ops/scripts/research-pipeline-cycle.sh
