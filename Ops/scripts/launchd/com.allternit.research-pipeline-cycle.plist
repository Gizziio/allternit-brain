<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.allternit.research-pipeline-cycle</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/joe/Desktop/Allternit/Allternit Brain/Ops/scripts/research-pipeline-cycle.sh</string>
  </array>

  <!-- Autonomy cycle: approvals → shadow/active execute → review → land.
       StartInterval fires every 30 min; StartCalendarInterval bounds cadence
       to 07:07–21:07 local. The script ALSO self-limits: it checks `date +%H`
       and no-ops outside 07:00–22:00 local, and single-instances itself with
       a lock on Research/.run.lock. Safe under autonomy.mode=shadow (default):
       shadow lists what would execute and never spawns executors. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>7</integer>
    </dict>
