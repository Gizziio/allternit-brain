<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.allternit.brain-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/joe/Desktop/Allternit/Allternit Brain/scripts/brain-pipeline.py</string>
    <string>--write</string>
  </array>

  <!-- Run nightly at 06:17 local time. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/joe/.allternit/logs/brain-audit.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joe/.allternit/logs/brain-audit.error.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
